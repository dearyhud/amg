# Copy to .env and adjust. docker-compose reads this automatically.

# Admin plane bearer token (constant-time compared; generate a real one):
#   openssl rand -hex 32
AMG_ADMIN_TOKEN=dev-admin-token-change-me

# Console sign-in password (simple password auth, v1; unset disables login)
AMG_ADMIN_PASSWORD=amg-dev-password

POSTGRES_PASSWORD=amg

# Upstream credentials, brokered by AMG (env-backed secret store in dev).
# vault_path "notion/key" -> AMG_SECRET_NOTION_KEY
AMG_SECRET_NOTION_KEY=
AMG_SECRET_STRIPE_KEY=

# Console: 0 = hit the real admin API through nginx (default),
# 1 = serve with the MSW mock API
VITE_MOCK=0
